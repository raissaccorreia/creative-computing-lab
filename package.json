{
  "name": "creative-computing-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "validate:pilot": "pnpm typecheck && pnpm lint && pnpm build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "stress:candidate-field": "node scripts/stress-candidate-field.mjs",
    "validate:system-anatomy": "node scripts/validate-system-anatomy.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/elms-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "motion": "^12.43.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
